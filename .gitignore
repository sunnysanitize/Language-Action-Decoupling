# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Environment variables and local secrets
.env
.env.*
!.env.example

# Episode output. Every run holds full prompts, model responses, and private
# reasoning, so these get large quickly and are regenerable from a seed plus
# calls.jsonl. Commit a specific run deliberately with `git add -f` if it
# backs a result.
runs/

# Test and coverage output
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Type-checker and linter caches
.mypy_cache/
.ruff_cache/

# Build and packaging output
build/
dist/
*.egg-info/

# Editors, operating systems and coding agents
.idea/
.vscode/
.DS_Store
nvim.log
CLAUDE.md
